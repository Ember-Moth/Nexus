# Generate separate, private local profiles with:
# uv run python scripts/dev_services.py start
# API: .env.api; worker: .env.worker; migrations: .env.migrate
# Production injects only the credentials needed by each process.
NEXUS_ENVIRONMENT=development
NEXUS_DATABASE_URL=postgresql+psycopg://nexus_api:change-me@127.0.0.1:55432/nexus
NEXUS_REDIS_URL=redis://:change-me@127.0.0.1:56379/0
# Required: URL-safe base64 encoding of 32 randomly generated bytes.
NEXUS_ENCRYPTION_KEY=generate-a-key-before-starting
NEXUS_ENCRYPTION_KEY_VERSION=1
NEXUS_PREVIOUS_ENCRYPTION_KEYS={}
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# Required by the API and the Worker: S3-compatible storage of export files (R2 in production,
# moto locally). Browsers download from the endpoint directly through presigned URLs.
NEXUS_OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:59000
NEXUS_OBJECT_STORAGE_BUCKET=nexus-app
NEXUS_OBJECT_STORAGE_REGION=us-east-1
NEXUS_OBJECT_STORAGE_ACCESS_KEY_ID=change-me
NEXUS_OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me
# Migrations (.env.migrate): fail on a busy table instead of queueing traffic behind the lock.
# NEXUS_MIGRATION_LOCK_TIMEOUT_MS=5000
# NEXUS_MIGRATION_STATEMENT_TIMEOUT_MS=0
# Static BFF peer IPs trusted for auth rate limiting, e.g. ["127.0.0.1"] for a local BFF.
# Requires NEXUS_AUTH_PROXY_SECRET, the secret the BFF signs each forwarded client IP with
# (same value on the BFF, at least 32 characters).
# NEXUS_AUTH_PROXY_PEERS=[]
# NEXUS_AUTH_PROXY_SECRET=

# Development/test only. Production rejects the mock transport.
# NEXUS_MOCK_PAYMENT_URL=http://127.0.0.1:59090

# Argon2 concurrency: sign-in and everything else (registration, recovery, setup) are separate.
# NEXUS_LOGIN_HASH_CONCURRENCY=2
# NEXUS_ACCOUNT_HASH_CONCURRENCY=1
# NEXUS_HASH_QUEUE_TIMEOUT_SECONDS=5

# Business policies are not environment variables: sign-in and mail limits, session lifetimes,
# reserved logins, the billing currency, vector storage, payment and export limits, the cluster
# policy and resource counts live in the database. So do the site's public console and API
# addresses (payment notifications), the identity mail provider and the Turnstile keys, whose
# secrets are encrypted with NEXUS_ENCRYPTION_KEY. Platform administrators change them under
# Platform > Settings or through /api/v1/settings/*; `nexus settings import --file` applies a
# policy file (docs/operations.md#策略文件导入).
