# Nexus management API base URL (without /api/v1). Server-side only; never exposed to the browser.
NEXUS_API_URL=http://127.0.0.1:8000
# Secure session cookies are the default and work on http://localhost.
# Set to false only for plain-HTTP hosts other than localhost.
# NEXUS_COOKIE_SECURE=false
# Public origin of the console when it runs behind a proxy that rewrites Host (CSRF Origin check).
# NEXUS_WEB_ORIGIN=https://console.example.com

# Set only when the console is reachable exclusively through an ingress that
# overwrites this header with the single verified IP of the external client.
# NEXUS_WEB_CLIENT_IP_HEADER=x-real-ip
# Shared with the API (same variable name there). The BFF signs each forwarded client IP with it;
# the API ignores unsigned addresses. At least 32 random characters, e.g. `openssl rand -base64 33`.
# NEXUS_AUTH_PROXY_SECRET=
